# Copy to .env (local) or paste into the ECS service environment.
# In .NET, "__" maps to ":" in configuration keys.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- Database (Aiven PostgreSQL) ---
ConnectionStrings__DefaultConnection=Host=HOST;Port=PORT;Database=defaultdb;Username=avnadmin;Password=CHANGE_ME;SslMode=Require;Trust Server Certificate=true;

# --- Authentication ---
Jwt__Secret=CHANGE_ME_64_RANDOM_CHARACTERS
Jwt__Issuer=Hospital
Jwt__Audience=Hospital
Jwt__ExpiresInMinutes=60

# --- CORS (comma-free: one variable per origin) ---
Cors__AllowedOrigins__0=https://your-cloudfront-domain

# --- Public sandbox ---
Demo__Enabled=true
Demo__ResetIntervalHours=24
Demo__ManualResetCooldownMinutes=10

# --- Email (leave disabled in the sandbox) ---
Email__Enabled=false
Email__Host=smtp.gmail.com
Email__Port=587
Email__EnableSsl=true
Email__Username=
Email__Password=
Email__FromEmail=no-reply@hospital.local
Email__FromName=HospitalSV
Email__HospitalName=HospitalSV
Email__TimeZoneOffsetMinutes=-360

# --- Only for a real (non-demo) deployment ---
# Seed__AdminPassword=
# Seed__DoctorPassword=
# Seed__ReceptionistPassword=
